{
  "name": "neuron-php/payments",
  "description": "Gateway-agnostic payment processing with a Stripe driver.",
  "type": "library",
  "license": "MIT",
  "authors": [
    {
      "name": "Lee Jones",
      "email": "lee@dragonflyrg.com"
    }
  ],
  "require": {
    "php": "^8.4",
    "ext-json": "*",
    "stripe/stripe-php": "^20.2 || ^22.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^13.4"
  },
  "autoload": {
    "psr-4": {
      "Neuron\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "test": "vendor/bin/phpunit"
}
